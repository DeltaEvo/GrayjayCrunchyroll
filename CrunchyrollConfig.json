{
  "name": "Crunchyroll (mzramna)",
  "description": "Watch the latest anime on Crunchyroll",
  "author": "mzramna (fork do plugin da FUTO)",
  "authorUrl": "https://github.com/mzramna",
  "platformUrl": "https://crunchyroll.com",
  "sourceUrl": "https://raw.githubusercontent.com/mzramna/GrayjayCrunchyroll/main/CrunchyrollConfig.json",
  "scriptUrl": "./CrunchyrollScript.js",
  "repositoryUrl": "https://github.com/mzramna/GrayjayCrunchyroll",
  "version": 20,
  "iconUrl": "./CrunchyrollIcon.png",
