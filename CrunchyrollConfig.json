{
	"name": "Crunchyroll",
	"description": "Crunchyroll plugin",
	"author": "DeltaEvo",
	"authorUrl": "https://github.com/DeltaEvo",
	"sourceUrl": "https://raw.githubusercontent.com/mzramna/GrayjayCrunchyroll/main/CrunchyrollConfig.json",
	"repositoryUrl": "https://github.com/mzramna/GrayjayCrunchyroll",
	"scriptUrl": "./CrunchyrollScript.js",
	"version": 7,
	"iconUrl": "./crunchyroll.png",
	"id": "3af73d7b-05bc-4a1b-a142-8a8377fc9c5b",
	"scriptSignature": "",
	"scriptPublicKey": "",
	"packages": [
		"Http"
	],
	"allowEval": false,
	"allowUrls": [
		"everywhere"
	],
	"authentication": {
		"loginUrl": "https://sso.crunchyroll.com/login?return_url=https%3A%2F%2Fwww.crunchyroll.com%2F",
		"cookiesToFind": [
			"etp_rt"
		],
		"cookiesExclOthers": false
	},
	"platformUrl": "https://www.crunchyroll.com",
	"changelog": {
		"4": [
			"Compatibilidade com Grayjay Desktop",
			"Busca com filtros de idioma de áudio (dublagem) e legenda",
			"Configurações de idioma (pt-BR incluído)"
		],
		"5": [
			"Corrige falha na instalação (403 no token)",
			"Usa a sessão logada para obter o token"
		],
		"6": [
			"Corrige detecção de login no Desktop"
		],
		"7": [
			"Quando a Cloudflare bloquear, abre a verificação para o usuário resolver"
		]
	},
	"settings": [
		{
			"variable": "locale",
			"name": "Idioma dos metadados",
			"description": "Idioma dos títulos e descrições",
			"type": "Dropdown",
			"default": "0",
			"options": [
				"pt-BR",
				"ja-JP",
				"en-US",
				"es-419",
				"es-ES",
				"fr-FR",
				"de-DE",
				"it-IT",
				"ru-RU",
				"ar-SA",
				"hi-IN",
				"ta-IN",
				"te-IN",
				"zh-CN",
				"ko-KR",
				"pt-PT"
			]
		},
		{
			"variable": "audioLanguage",
			"name": "Idioma de áudio preferido",
			"description": "Usado na home e nas temporadas",
			"type": "Dropdown",
			"default": "1",
			"options": [
				"pt-BR",
				"ja-JP",
				"en-US",
				"es-419",
				"es-ES",
				"fr-FR",
				"de-DE",
				"it-IT",
				"ru-RU",
				"ar-SA",
				"hi-IN",
				"ta-IN",
				"te-IN",
				"zh-CN",
				"ko-KR",
				"pt-PT"
			]
		},
		{
			"variable": "onlyPreferredAudio",
			"name": "Home: só áudio preferido",
			"description": "Mostrar na home apenas episódios no idioma de áudio preferido",
			"type": "Boolean",
			"default": "false"
		}
	],
	"captcha": {
		"captchaUrl": "https://www.crunchyroll.com/",
		"cookiesToFind": [
			"cf_clearance"
		]
	}
}