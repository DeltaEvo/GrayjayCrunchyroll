{
	"name": "Crunchyroll",
	"description": "Crunchyroll plugin",
	"author": "DeltaEvo",
	"authorUrl": "https://github.com/DeltaEvo",
	"sourceUrl": "https://raw.githubusercontent.com/mzramna/GrayjayCrunchyroll/main/CrunchyrollConfig.json",
	"repositoryUrl": "https://github.com/mzramna/GrayjayCrunchyroll",
	"scriptUrl": "./CrunchyrollScript.js",
	"version": 11,
	"iconUrl": "./crunchyroll.png",
	"id": "3af73d7b-05bc-4a1b-a142-8a8377fc9c5b",
	"scriptSignature": "",
	"scriptPublicKey": "",
	"packages": [
		"Http"
	],
	"allowEval": false,
	"allowUrls": [
		"www.crunchyroll.com",
		"static.crunchyroll.com",
		"cr-play-service.prd.crunchyrollsvc.com",
		"v.vrv.co"
	],
	"authentication": {
		"userAgent": "Mozilla/5.0 (Linux; Android 10) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/110.0.5481.153 Mobile Safari/537.36",
		"loginUrl": "https://sso.crunchyroll.com/login",
		"cookiesToFind": [
			"etp_rt"
		],
		"cookiesExclOthers": true
	},
	"changelog": {
		"11": [
			"Recomeça do plugin original (login original)",
			"Busca com filtros de áudio e legenda (pt-BR incluído)",
			"Idiomas configuráveis",
			"Compatibilidade de JS com o Desktop"
		]
	},
	"settings": [
		{
			"variable": "locale",
			"name": "Idioma dos metadados",
			"description": "Idioma dos títulos e descrições",
			"type": "Dropdown",
			"default": "0",
			"options": [
				"pt-BR",
				"ja-JP",
				"en-US",
				"es-419",
				"es-ES",
				"fr-FR",
				"de-DE",
				"it-IT",
				"ru-RU",
				"ar-SA",
				"hi-IN",
				"ta-IN",
				"te-IN",
				"zh-CN",
				"ko-KR",
				"pt-PT"
			]
		},
		{
			"variable": "audioLanguage",
			"name": "Idioma de áudio preferido",
			"description": "Usado na home e nas temporadas",
			"type": "Dropdown",
			"default": "1",
			"options": [
				"pt-BR",
				"ja-JP",
				"en-US",
				"es-419",
				"es-ES",
				"fr-FR",
				"de-DE",
				"it-IT",
