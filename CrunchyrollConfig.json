  "changelog": {
    "4": [
      "Add pagination to content and creators search;"
    ],
    "7": [
      "Add setting to set preferred subtitle;"
    ],
    "12": [
      "Fix playback tracking;"
    ],
    "13": [
      "Fix authenticated session issue;"
    ],
    "14": [
      "Fix: error when description contains alternate streams in Japanese;"
    ],
    "15": [
      "Fix: Home tab error;"
    ],
    "16": [
      "Fix: Subtitles not properly escaping commas;",
      "Fix: Sort skip events by start time in content chapters;",
      "Improvement: Support deep linking from localized URLs (e.g. fr-fr, en-us) for video and series pages;",
      "Improvement: Include closed captions (cc) as subtitles when available;",
      "Improvement: Categorize skip events as skippable or normal in content chapters;",
      "Configuration: Update author URL from futo.org to futo.tech;"
    ],
    "17": [
      "Fix: Playback failing because the license is now returned as binary instead of base64;"
    ],
    "18": [
      "Add: Desktop support (requires a desktop build with Widevine);"
    ],
    "19": [
      "Fix: Error when opening an episode that has not aired yet;",
      "Improvement: Show upcoming episodes as planned on desktop;",
      "Improvement: Show unavailable episodes as locked or hide them, following the premium content setting;"
    ],
